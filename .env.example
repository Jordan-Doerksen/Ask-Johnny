# Discord bot token (Developer Portal → your app → Bot → Reset Token)
BOT_TOKEN=paste_your_bot_token_here

# Discord Application ID (Developer Portal → General Information → Application ID)
CLIENT_ID=paste_your_client_id_here

# Groq API key (console.groq.com → API Keys). The primary provider.
GROQ_API_KEY=paste_your_groq_key_here

# Optional: register commands to ONE server for instant updates while testing.
# Leave blank to register globally (can take up to an hour to appear).
GUILD_ID=

# Optional: override the Groq model. Defaults to openai/gpt-oss-120b (config/llm.json).
# Set this when a model is retired and you need Johnny back before anyone can edit code.
GROQ_MODEL=

# Optional: the FALLBACK provider — Cloudflare Workers AI. Johnny uses it automatically
# when Groq fails or its daily cap runs out. Leave BOTH blank to run Groq-only; an
# unconfigured fallback is skipped silently and costs nothing.
#   CF_ACCOUNT_ID — dash.cloudflare.com → Workers & Pages → your account ID (right side)
#   CF_API_TOKEN  — My Profile → API Tokens → Create Token → Workers AI (Read) template
CF_ACCOUNT_ID=
CF_API_TOKEN=
# Optional: override the Cloudflare model (defaults in config/llm.json).
CF_MODEL=

# Optional: daily data backup to Discord. Once a day the bot posts
# data/johnny.json so a host wipe can't lose your reminders, quotes and lore.
# Set ONE (leave both blank to turn it off):
#   BACKUP_CHANNEL_ID — a PRIVATE channel to post backups to (preferred), or
#   OWNER_ID          — your user id, to receive them as a DM.
# (Discord → Settings → Advanced → Developer Mode, then right-click to copy ids.)
BACKUP_CHANNEL_ID=
OWNER_ID=
